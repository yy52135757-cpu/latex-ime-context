// ============================================================
// 环境类片段
// ============================================================
// 注意：所有「单词触发词」的自动展开已交给 latex-ime-context 扩展
// （它能正确处理中文输入法的组合串上屏，不会留下半个词）。
// 这里已把这些片段的 A 标志去掉，它们仍可用 Tab 手动展开，作为扩展停用时的后备。
// 正则类/JS 类片段（// -> !> 000 自动分数 自动下标 today box）不受影响，仍由 hsnips 自动展开。
// ============================================================

snippet beg "begin/end 环境" b
\begin{${1:theorem}}
	$0
\end{$1}
endsnippet

snippet thm "定理环境（无标题）" w
\begin{theorem}
	$1
\end{theorem}
endsnippet

snippet thmt "定理环境（带标题）" w
\begin{theorem}[\textbf{${1:标题}}]
	$2
\end{theorem}
endsnippet

snippet lm "引理环境（无标题）" w
\begin{lemma}
	$1
\end{lemma}
endsnippet

snippet lmt "引理环境（带标题）" w
\begin{lemma}[\textbf{${1:标题}}]
	$2
\end{lemma}
endsnippet

snippet def "定义环境（无标题）" w
\begin{definition}
	$1
\end{definition}
endsnippet

snippet deft "定义环境（带标题）" w
\begin{definition}[\textbf{${1:标题}}]
	$2
\end{definition}
endsnippet

snippet proof "证明环境" w
\begin{proof}
	$1
\end{proof}
endsnippet

snippet prooft "证明环境（带标题）" w
\begin{proof}[${1:证明}]
	$2
\end{proof}
endsnippet

snippet rm "注记环境" w
\begin{remark}
	$1
\end{remark}
endsnippet

snippet enu "enumerate 环境" w
\begin{enumerate}
	\item $1
\end{enumerate}
endsnippet


// ============================================================
// 进入数学模式的片段（保留自动展开）
// ============================================================

// 行内公式 mk / 显示公式 dm 的片段：
// 已改由扩展 LaTeX IME Context 内置处理（中文输入法「一次上屏」时也能正确展开），
// 这里不再重复定义，避免两边打架。想用快捷键则是 Ctrl+Alt+D / Ctrl+Alt+K。
// （text → \text{} 的自动展开已按用户要求彻底移除，不再有任何触发词。）


// ============================================================
// 数学模式片段（保留自动展开）
// ============================================================

snippet // "分数" Am
\frac{$1}{$2}
endsnippet

snippet set "集合" im
\{$1\\}
endsnippet

snippet oper "操作" m
\operatorname{$1}($2)
endsnippet

// 注：text → \text{} 的自动展开已移除（用户不需要，且中文输入法下偶发 "\textt{}"）。

snippet `((\d+)|(\d*)(\\)?([A-Za-z]+)((\^|_)(\{\d+\}|\d))*)/` "自动分数" A
\frac{``rv = m[1]``}{$1}
endsnippet

snippet fr "选中文本变分数" im
\frac{${1:${VISUAL}}}{$2}
endsnippet

snippet `([A-Za-z])(\d)` "自动下标" iA
``rv = m[1]``_``rv = m[2]``
endsnippet

snippet `([A-Za-z])_(\d\d)` "自动下标（两位数）" iA
``rv = m[1]``_{``rv = m[2]``}
endsnippet

snippet sr "平方" im
^2
endsnippet

snippet cb "立方" im
^3
endsnippet

snippet comp "补集" im
^{c}
endsnippet

// 上标：数学环境里输入 ^ 立即展开为 ^{-1}，光标在花括号中（-1 默认选中，
// 直接打字即替换，如打 2 得到 ^{2}）；不替换时按 Tab 保留 -1 并跳到 } 之后
snippet `\^$` "上标（默认 -1）" iAm
^{${1:-1}}
endsnippet

snippet td "上标" im
^{$1}
endsnippet

snippet sb "下标" im
_{$1}
endsnippet


// ============================================================
// 后缀片段（保留自动展开）
// ============================================================

snippet `([a-zA-Z])bar` "后缀 bar" iAm
\ov{``rv = m[1]``}
endsnippet

snippet `([a-zA-Z])hat` "后缀 hat" iAm
\hat{``rv = m[1]``}
endsnippet

snippet `(\\?\w+)(,\.|\.,)` "后缀向量" iAm
\vec{``rv = m[1]``}
endsnippet

snippet bar "bar" im
\ov{$1}
endsnippet

snippet hat "hat" im
\hat{$1}
endsnippet


// ============================================================
// 常用符号（保留自动展开）
// ============================================================

snippet -> "趋于箭头" iAm
\to 
endsnippet

snippet !> "映射到箭头" iAm
\mapsto 
endsnippet

snippet 000 "无穷" wm
\infty
endsnippet

snippet ooo "无穷（备用）" im
\infty 
endsnippet

snippet cc "子集" im
\subset 
endsnippet

snippet sum "求和符号" im
\sum_{${1:n=1}}^{${2:\infty}} 
endsnippet

snippet lim "极限符号" im
\lim_{${1:n} \to ${2:\infty}} 
endsnippet

snippet RR "实数" im
\mathbb{R}
endsnippet


// ============================================================
// 其他（保留自动展开）
// ============================================================

snippet sec "section" w
\section{${1:标题}}
endsnippet

snippet bf "textbf" w
\textbf{${1:文本}}
endsnippet

snippet today "当前日期" wA
``rv = new Date().toISOString().slice(0, 10)``
endsnippet

// 函数定义：与 lecture 中的写法完全一致 —— 外面套 \[ ... .\]，
// 内部两行 aligned，箭头处用 & 对齐；箭头左右各一个 \quad 保持对称，
// 想加宽改成 \qquad 或 \hspace{1em}，想变窄改成 \,（左右要一起改）
snippet function "函数定义（显示块 + 对齐）" im
\begin{aligned}
${1:f}\colon ${2:X} &\quad\to\quad ${3:Y} \\\\
${4:x} &\quad\mapsto\quad ${5:${1}(${4})}
\end{aligned}
endsnippet

snippet box "Box" wA
``rv = '┌' + '─'.repeat(t[0].length + 2) + '┐'``
│ $1 │
``rv = '└' + '─'.repeat(t[0].length + 2) + '┘'``
endsnippet


// ============================================================
// 文件头 + 文件尾模板
// ============================================================

snippet lec "LaTeX 文件（头+尾）" w
\documentclass[UTF8]{ctexart}
\usepackage[a4paper,margin=2.6cm]{geometry}
\usepackage{graphicx}
\usepackage[colorlinks=true,linkcolor=blue]{hyperref}
\usepackage{amsmath,amssymb,amsfonts,amsthm,mathtools}
\usepackage{mathrsfs}
% \usepackage{extarrows}  % not available; \xleftrightarrow defined below
\makeatletter
\providecommand{\xleftrightarrow}[2][]{%
  \mathrel{\mathop{%
    \vcenter{\hbox{\ooalign{%
      \hfil\$\m@th\leftarrow\mkern-1mu\mkern3.5mu\rightarrow\$\hfil\cr
      \hfil\$\m@th\mkern-2mu\scriptstyle#1\mkern-2mu\$\hfil\cr
      \hfil\$\m@th\mkern-2mu\scriptstyle#2\mkern-2mu\$\hfil\cr
    }}}%
  }}%
}
\makeatother
\usepackage{tikz}
\usepackage{tikz-cd}
\usetikzlibrary{arrows.meta, positioning}

% Math blackboard bold
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\F}{\mathbb{F}}
\newcommand{\waveto}{\overset{\sim}{\to}}
% Topology symbols
\newcommand{\Top}{\mathcal{T}}
\newcommand{\Pow}{\mathcal{P}}
\newcommand{\B}{\mathcal{B}}
\newcommand{\Card}{\operatorname{Card}}
\newcommand{\Cl}{\operatorname{Cl}}
\newcommand{\GL}{\operatorname{GL}}
% 统一高度的上划线：\vphantom{b} 把内容撑到 ascender 高度；
% 相邻的 \ov 之间自动留 3mu 细缝，避免 \ov{a}\ov{b} 的两条横线连成一条
\makeatletter
\newcommand{\ov}[1]{\overline{#1\vphantom{b}}\@ifnextchar\ov{\mkern3mu}{}}
\makeatother

\title{${1:抽象代数笔记}}
\author{Gryllidae}
\date{\today}

\newtheorem{theorem}{定理}[section]
\newtheorem{lemma}[theorem]{引理}
\newtheorem{definition}[theorem]{定义}
\newtheorem{remark}{注记}[section]
\numberwithin{equation}{section}

% ==========================================
% Proof toggle mechanism
% ==========================================
% Comment/uncomment the line below to show/hide proofs
\newif\ifshowproofs
\showproofstrue   % Set to \showproofsfalse to hide all proof content
%\showproofsfalse

% Proof toggle: set \showproofsfalse above to hide all proof content
% Proof bodies are collected into a box and dumped invisibly at end of document,
% so main layout is untouched while labels survive in .aux
\ifshowproofs\else
  \usepackage{environ}
  \newsavebox{\proofsbox}%
  \setbox\proofsbox=\vbox{}%
  \RenewEnviron{proof}[1][\proofname]{%
    \global\setbox\proofsbox=\vbox{%
      \unvbox\proofsbox
      \special{pdf:code Tr 3}%
      \BODY
      \special{pdf:code Tr 0}%
    }%
  }
  \AtEndDocument{%
    \special{pdf:code Tr 3}%
    \vbox to 0pt{\unvbox\proofsbox\vss}%
    \special{pdf:code Tr 0}%
  }
\fi

\begin{document}
\maketitle

\tableofcontents
\newpage
$0

\end{document}
endsnippet